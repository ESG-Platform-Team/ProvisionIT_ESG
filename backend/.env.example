# Get a key at https://aistudio.google.com/apikey
# Never commit the real .env file. .env is in .gitignore.
GEMINI_API_KEY=

# Free tier covers Flash. gemini-2.5-flash was withdrawn for new users mid-build.
GEMINI_MODEL=gemini-3.6-flash
# Tried in order if the model above is withdrawn.
GEMINI_FALLBACK_MODELS=gemini-3.7-flash

# Free tier Flash sits around 10 to 15 requests per minute. Stay under it.
GEMINI_RPM=10

# Any localhost port is allowed automatically for development. Add others here.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Email. Leave SMTP_HOST empty and nothing is sent: every message is saved to
# data/mail as an .eml file instead, which is the safe default for demos.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Provision IT ESG Platform <esg@provisionit.com.au>
SMTP_REPLY_TO=
SMTP_STARTTLS=true
SMTP_SSL=false

# Where a company's browser reaches the response page for a disclosure request.
PUBLIC_BASE_URL=http://localhost:8080
DISCLOSURE_DUE_DAYS=21
