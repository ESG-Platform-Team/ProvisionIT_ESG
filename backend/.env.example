# Get a key at https://aistudio.google.com/apikey
# Never commit the real .env file. Add .env to .gitignore.
GEMINI_API_KEY=

# Free tier covers Flash and Flash-Lite. Pro is paid only.
GEMINI_MODEL=gemini-2.5-flash

# Free tier Flash sits around 10 to 15 requests per minute. Stay under it.
GEMINI_RPM=10

ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
